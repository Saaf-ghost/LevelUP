DB_NAME=boostup
DB_URL=jdbc:postgresql://localhost:55432/boostup
DB_USERNAME=boostup
DB_PASSWORD=boostup
JWT_SECRET=change-this-development-jwt-secret-at-least-32-chars
JWT_EXPIRATION_SECONDS=86400
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REVIEW_THRESHOLD_HOURS=48
VITE_API_BASE_URL=http://localhost:8082

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=boostup
RABBITMQ_PASSWORD=boostup

# Upload storage
UPLOAD_DIR=./uploads

# AI Service Settings
