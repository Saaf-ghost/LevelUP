# ============================================================
# BoostUP / LevelUP - repository ignore rules
# Anything listed here is local-only and must never be pushed.
# ============================================================

# ---------- Secrets & local environment ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/
application-local.properties
application-*.secret.properties

# ---------- Java / Maven (backend) ----------
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
HELP.md
.apt_generated
.springBeans
.sts4-cache

# ---------- Python (ai-service) ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
*.ipynb_checkpoints/

# ---------- Node / Vite (frontend) ----------
node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Editor / IDE ----------
.vscode/
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# ---------- Developer-only documents ----------
BACKLOG.md
AGENTS.md

# ---------- OS / tooling junk ----------
.DS_Store
Thumbs.db
desktop.ini
*.log
logs/
.freebuff/
